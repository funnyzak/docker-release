# 使用 openssl rand -hex 32 生成；启动时要求至少 32 个字符。
WEBHOOK_TOKEN=
WEBHOOK_AUTH_MODE=query
# SSH URL 或无内嵌密码的 HTTPS URL。
GIT_REPO_URL=
# GitHub 为 owner/repo；generic 请求的 repository 必须与此值完全相同。
GIT_REPO_NAME=
# pipeline.json 为本地复制并编辑的配置，不提交。
PIPELINE_FILE=./pipeline.json
# 默认镜像内置 JDK 17；需要 8/11/25 时改用 1.0.0-java8、1.0.0-java11、1.0.0-java25 等 tag。
GIT_BUILDER_IMAGE=funnyzak/git-builder:1.0.0
# 仅源码构建（docker compose build）时生效，可选 8、11、17、25。
JAVA_VERSION=17
BIND_ADDRESS=127.0.0.1
HOST_PORT=9000
# 填写包含 /notify/<KEY> 的完整地址；留空关闭通知。
APPRISE_NOTIFY_URL=
APPRISE_TAG=
# 可选，完整请求头值，例如 Bearer ... 或 Basic ...；取决于外部网关。
APPRISE_AUTHORIZATION=
