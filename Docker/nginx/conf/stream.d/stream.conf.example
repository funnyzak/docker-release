# Copy this file to stream.conf, uncomment the ngx_stream_module and/or
# ngx_mail_module load_module lines at the top of /etc/nginx/nginx.conf,
# then uncomment the block you need.
# Only one stream{} and one mail{} block may exist in the whole configuration,
# so keep every server of the same kind inside this single file.

