# Copy this file to stream.conf and enable the matching module(s) to activate:
#   NGINX_ENABLED_MODULES=stream        for stream
#   NGINX_ENABLED_MODULES=mail          for mail
# Only one stream{} and one mail{} block may exist in the whole configuration,
# so keep every server of the same kind inside this single file.

