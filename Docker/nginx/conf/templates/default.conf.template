server {
    listen       ${NGINX_LISTEN_PORT};
    server_name  ${NGINX_SERVER_NAME};

    # Optional deployment tag header — disabled by default: it fingerprints
    # the image. Uncomment to advertise your build (renders NGINX_SERVER_BUILD).
    # more_set_headers 'Server-Build: ${NGINX_SERVER_BUILD}';

    error_page 403 @jump_to_403;
    location @jump_to_403 {
        default_type text/html;
        return 403 '<html><title>403 Forbidden</title><body><h1>403 Forbidden</h1></body></html>';
    }

    error_page 401 @jump_to_401;
    location @jump_to_401 {
        default_type text/html;
        return 401 '<html><title>401 Unauthorized</title><body><h1>401 Unauthorized</h1></body></html>';
    }

    error_page 404 @jump_to_404;
    location @jump_to_404 {
        default_type text/html;
        return 404 '<html><title>404 Not Found</title><body><h1>Not Found</h1></body></html>';
    }

    # 5xx responses keep their real status codes so load balancers, alerts,
    # retries and troubleshooting still see 500/502/503/504 as generated.

    location / {
        root   ${NGINX_WEB_ROOT};
        index  ${NGINX_INDEX_FILES};
        # add_header Content-Type text/html;
        # return 200 '<div style="height:100vh;width:100vw;display:flex;justify-content: center;align-items: center;"><h1 style="padding:50px;text-align:center;">This is the end of the internet, so you may need to search for information elsewhere.</h1></div>';
    }

    # ---- Optional module examples: uncomment the matching load_module line
    # ---- at the top of nginx.conf, then uncomment what you need below.

    # Fancy directory listing (ngx_http_fancyindex_module)
    # location /files/ {
    #     alias /data/files/;
    #     fancyindex on;
    #     fancyindex_exact_size off;
    #     fancyindex_localtime on;
    # }

    # Image resizing (ngx_http_image_filter_module)
    # location ~* ^/thumb(/.+)$ {
    #     alias /data/images$1;
    #     image_filter resize 300 200;
    #     image_filter_jpeg_quality 85;
    #     image_filter_buffer 10M;
    # }

    # XSLT rendering (ngx_http_xslt_filter_module)
    # location /feed {
    #     root /data/xml;
    #     xslt_stylesheet /etc/nginx/xslt/style.xslt;   # text/xml is handled by default
    # }

    # Perl handler (ngx_http_perl_module)
    # location = /hello {
    #     perl 'sub { my $r = shift; $r->send_http_header("text/plain"); $r->print("hi from nginx perl"); return OK; }';
    # }

    # Trust a proxy in front of this container (built-in real_ip):
    # set_real_ip_from 172.16.0.0/12;
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;

    # Minimal status endpoint (built-in)
    # location = /nginx_status {
    #     stub_status;
    #     allow 127.0.0.1;
    #     deny all;
    # }

    # Allow access from China only (ngx_http_geoip2_module; also enable the
    # geoip2 + map example in nginx.conf and mount a Country mmdb database).
    # if ($is_china = 0) {
    #     return 403;
    # }
}

